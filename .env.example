DATABASE_URL=postgresql://sponsorai:sponsorai@localhost:5432/sponsorai
NEXTAUTH_SECRET=changeme-generate-a-real-secret
NEXTAUTH_URL=http://localhost:3000
GROK_API_KEY=xai-xxx
GROK_MODEL=grok-4.6
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_SCOUT_MODEL=claude-sonnet-5
APOLLO_API_KEY=
# Server-only Monid key. Enables LinkedIn + Hunter before the Apollo fallback.
# Do not use NEXT_PUBLIC_ or commit the real key.
MONID_API_KEY=
# Per-enrichment reservation limit in USD, excluding existing AI-provider costs.
MONID_ENRICHMENT_MAX_USD=0.50
OUTREACH_WEBHOOK_SECRET=replace-with-a-long-random-secret

# IONOS / vectis.agency mailbox
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@vectis.agency
SMTP_PASS=your-ionos-mailbox-password
SMTP_FROM=contact@vectis.agency
SMTP_REPLY_TO=contact@vectis.agency
MAIL_FROM_NAME=Vectis Agency

# Automatic inbound reply synchronization (falls back to SMTP_USER / SMTP_PASS)
IMAP_HOST=imap.ionos.fr
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=contact@vectis.agency
IMAP_PASS=your-ionos-mailbox-password

# Vercel sends this secret as Authorization: Bearer <secret> to the daily cron
CRON_SECRET=replace-with-a-long-random-secret
